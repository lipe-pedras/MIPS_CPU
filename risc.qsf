# =============================================================================
# risc.qsf - Configuracao do projeto Quartus (RISC pipeline 5 estagios).
# FPGA: Cyclone IV GX (obrigatorio pelo roteiro).
# =============================================================================
set_global_assignment -name FAMILY "Cyclone IV GX"
set_global_assignment -name DEVICE EP4CGX22CF19C7
set_global_assignment -name TOP_LEVEL_ENTITY risc
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 18.1
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# ---- arquivos fonte (sem testbenches) ----
set_global_assignment -name VERILOG_FILE register.v
set_global_assignment -name VERILOG_FILE mux.v
set_global_assignment -name VERILOG_FILE pc.v
set_global_assignment -name VERILOG_FILE alu.v
set_global_assignment -name VERILOG_FILE extend.v
set_global_assignment -name VERILOG_FILE control.v
set_global_assignment -name VERILOG_FILE registerfile.v
set_global_assignment -name VERILOG_FILE InstMem.v
set_global_assignment -name VERILOG_FILE datamemory.v
set_global_assignment -name VERILOG_FILE ADDRDecoding.v
set_global_assignment -name VERILOG_FILE ADDRDecoding_Prog.v
set_global_assignment -name VERILOG_FILE PLL/PLL.v
set_global_assignment -name VERILOG_FILE Multiplicador/Adder.v
set_global_assignment -name VERILOG_FILE Multiplicador/ACC.v
set_global_assignment -name VERILOG_FILE Multiplicador/Counter.v
set_global_assignment -name VERILOG_FILE Multiplicador/CONTROL.v
set_global_assignment -name VERILOG_FILE Multiplicador/Multiplicador.v
set_global_assignment -name VERILOG_FILE risc.v

# ---- timing / SDC ----
set_global_assignment -name SDC_FILE risc.sdc

# ---- saida EDA p/ simulacao Gate Level (ModelSim, Verilog) ----
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim-Altera (Verilog)"
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_simulation

set_global_assignment -name LAST_QUARTUS_VERSION "18.1.0 Lite Edition"
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name EDA_TEST_BENCH_ENABLE_STATUS TEST_BENCH_MODE -section_id eda_simulation
set_global_assignment -name EDA_NATIVELINK_SIMULATION_TEST_BENCH risc_TB -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_NAME risc_TB -section_id eda_simulation
set_global_assignment -name EDA_DESIGN_INSTANCE_NAME NA -section_id risc_TB
set_global_assignment -name EDA_TEST_BENCH_MODULE_NAME risc_TB -section_id risc_TB
set_global_assignment -name EDA_TEST_BENCH_FILE risc_TB.v -section_id risc_TB
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top